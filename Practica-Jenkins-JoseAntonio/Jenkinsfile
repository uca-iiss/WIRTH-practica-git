pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'python -m py_compile Practica-Jenkins-JoseAntonio/sources/add2vals.py Practica-Jenkins-JoseAntonio/sources/calc.py'
                stash(name: 'compiled-results', includes: 'Practica-Jenkins-JoseAntonio/sources/*.py*')
            }
        }
        stage('Test') { 
            steps {
                sh 'py.test --junit-xml test-reports/results.xml Practica-Jenkins-JoseAntonio/sources/test_calc.py' 
            }
            post {
                always {
                    junit 'test-reports/results.xml' 
                }
            }
        }
    }
}

