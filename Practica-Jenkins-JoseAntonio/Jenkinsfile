pipeline {
  agent {
    docker {
      image 'python:3.11'  // Usa imagen oficial de Python con pip ya instalado
    }
  }

  stages {
    stage('Instalar dependencias') {
      steps {
        dir('docs') {
          sh 'pip install -r requirements.txt'
        }
      }
    }

    stage('Docker Build') {
      steps {
        echo 'Aquí va tu docker build...'
      }
    }

    stage('Docker Run') {
      steps {
        echo 'Aquí va tu docker run...'
      }
    }
  }

  post {
    failure {
      echo 'Fallo en el pipeline'
    }
  }
}
